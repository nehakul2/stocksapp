# Copy to backend/.env for local use. Never commit the real .env.

# Leave empty to use a local SQLite file (stocksapp.db). For Neon/Railway Postgres, paste the connection string.
DATABASE_URL=

# Long random string used to sign login sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Websites allowed to call this API from a browser (comma-separated). Your deployed frontend URL goes here.
CORS_ORIGINS=http://localhost:3000

# AI explanations. One key on the server; friends don't need their own.
# Leave empty to switch AI off. Create a key at console.anthropic.com and set a spending limit there too.
ANTHROPIC_API_KEY=
# Explanations per user per day, and for everyone combined (a ceiling on cost).
AI_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=200

# Email alerts (optional). Create a key at resend.com. Until you verify a domain there, Resend can only
# deliver to your own address, so put it in EMAIL_ALLOWED_TO.
RESEND_API_KEY=
EMAIL_ALLOWED_TO=
# EMAIL_FROM=Stock Insights <onboarding@resend.dev>
# FRONTEND_URL=https://your-frontend.up.railway.app
# ALERT_EMAIL_MINUTES=15
# Time zone used for the times written inside alert emails (the website shows times in the viewer's own zone).
# ALERT_TIMEZONE=America/Los_Angeles
